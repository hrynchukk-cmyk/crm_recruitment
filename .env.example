# Скопіюйте у .env і заповніть.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Для HTTPS-домену, напр.: https://crm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Для локального запуску без HTTPS поставте 0
DJANGO_SECURE_COOKIES=1

POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Інтеграція з Work.ua: disabled | api (після отримання партнерського доступу)
WORKUA_BACKEND=disabled
WORKUA_API_BASE_URL=
WORKUA_LOGIN=
WORKUA_PASSWORD=
