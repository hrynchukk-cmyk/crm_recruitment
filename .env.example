# Скопіюйте у файл .env і поміняйте паролі.
# Ці налаштування готові для запуску на своєму комп'ютері (http://localhost:8000).
# Для сервера з доменом див. README, розділ «Розгортання на сервері».

DJANGO_DEBUG=0
# Будь-який довгий випадковий рядок (50+ символів)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# На сервері з HTTPS: https://ваш-домен
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# 0 — для http://localhost; на сервері з HTTPS поставте 1
DJANGO_SECURE_COOKIES=0

# Перший адміністратор (створюється автоматично при першому запуску)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me

POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-too
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Інтеграція з Work.ua: disabled | api (після отримання партнерського доступу)
WORKUA_BACKEND=disabled
WORKUA_API_BASE_URL=
WORKUA_LOGIN=
WORKUA_PASSWORD=
